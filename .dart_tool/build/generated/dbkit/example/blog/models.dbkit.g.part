/// Relationship accessors for [Post].
extension PostRelations on Post {
  /// The author this post belongs to, or null.
  Future<User?> author(Db db) async {
    final fk = userId;
    final m = await db.users.ref.findById(fk);
    return m == null ? null : User.fromMap(m);
  }

  /// Tags linked to this post via `post_tags`.
  Future<List<Tag>> tags(Db db) async {
    final key = id;
    if (key == null) {
      return [];
    }
    final pivots =
        await db.postTags.ref.where((w) => w.eq('post_id', key)).get();
    final ids = <Object?>[for (final p in pivots) p['tag_id']];
    if (ids.isEmpty) {
      return [];
    }
    final rows = await db.tags.ref.where((w) => w.inList('id', ids)).get();
    return [for (final m in rows) Tag.fromMap(m)];
  }

  /// Links [other] to this post.
  Future<void> addTag(Db db, Tag other) async {
    final pid = id;
    final tid = other.id;
    if (pid == null || tid == null) {
      throw StateError('Cannot link Post with null id');
    }
    await db.postTags.ref.insert({'post_id': pid, 'tag_id': tid});
  }

  /// Unlinks [other] from this post.
  Future<void> removeTag(Db db, Tag other) async {
    final pid = id;
    final tid = other.id;
    if (pid == null || tid == null) {
      return;
    }
    await db.postTags.deleteWhere(
      (w) => w.eq('post_id', pid) & w.eq('tag_id', tid),
    );
  }
}

